{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidian",
  "version": "0.1.0",
  "identifier": "app.obsidian.b2b",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Obsidian",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "backgroundColor": "#0a0a0d"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
